    text = ''
      #!/bin/bash
      # Wrapper script for isql with proper environment variables

      # Expand ~ to actual home directory since this might be called from Emacs
      HOME="''${HOME:-''$(/usr/bin/printenv HOME)}"
      if [[ -z "''$HOME" ]]; then
        HOME="/Users/mmagueta"
      fi

      export ODBCINI="''$HOME/.odbc.ini"
      export ODBCSYSINI="''$HOME/.config/odbc"
      export DYLD_LIBRARY_PATH="${pkgs.openssl.out}/lib''${DYLD_LIBRARY_PATH:+:''$DYLD_LIBRARY_PATH}"

      # Parse osql-style arguments and convert to isql format
      # osql uses -S server -U user -P password
      # isql uses: isql DSN user password [options]

      SERVER=""
      USER=""
      PASSWORD=""
      OPTIONS=()

      while [[ ''$# -gt 0 ]]; do
        case ''$1 in
          -S)
            SERVER="''$2"
            shift 2
            ;;
          -U)
            USER="''$2"
            shift 2
            ;;
          -P)
            PASSWORD="''$2"
            shift 2
            ;;
          *)
            OPTIONS+=("''$1")
            shift
            ;;
        esac
      done

      # Filter out unsupported options
      ISQL_OPTIONS=()
      skip_next=false
      for opt in "''${OPTIONS[@]}"; do
        if ''$skip_next; then
          skip_next=false
          continue
        fi
        case "''$opt" in
          -d)
            # Skip -d and its argument (database flag, not supported by isql)
            skip_next=true
            ;;
          -v|-n|-b|-c|-w|-q|-3|-e|-k)
            # Keep supported isql options
            ISQL_OPTIONS+=("''$opt")
            ;;
          -d*)
            # Skip combined -dDATABASE
            ;;
          *)
            # Keep other options
            ISQL_OPTIONS+=("''$opt")
            ;;
        esac
      done

      # If we have server/user/password from flags, use them
      if [[ -n "''$SERVER" ]]; then
        exec ${pkgs.unixODBC}/bin/isql "''${ISQL_OPTIONS[@]}" "''$SERVER" "''$USER" "''$PASSWORD"
      else
        # Otherwise just pass through arguments as-is (for isql format)
        exec ${pkgs.unixODBC}/bin/isql "''$@"
      fi
    '';
    executable = true;
  };

  home.file.".local/bin/tsql-wrapper.sh" = {
    text = ''
      #!/bin/bash
      # Wrapper script for tsql to handle Emacs sql-mode arguments
      # Emacs sql-ms mode passes arguments that need translation for tsql

      HOST=""
      PORT=""
      USER=""
      PASSWORD=""
      DATABASE=""
      OTHER_ARGS=()

      # Parse arguments
      while [[ ''$# -gt 0 ]]; do
        case ''$1 in
          -S)
            HOST="''$2"
            shift 2
            ;;
          -H)
            HOST="''$2"
            shift 2
            ;;
          -p)
            PORT="''$2"
            shift 2
            ;;
          -U)
            USER="''$2"
            shift 2
            ;;
          -P)
            PASSWORD="''$2"
            shift 2
            ;;
          -d|-D)
            DATABASE="''$2"
            shift 2
            ;;
          *)
            OTHER_ARGS+=("''$1")
            shift
            ;;
        esac
      done

      # Set default port if not provided
      [[ -z "''$PORT" ]] && PORT="1433"

      # Build tsql command
      TSQL_CMD=(${pkgs.freetds}/bin/tsql)

      [[ -n "''$HOST" ]] && TSQL_CMD+=(-H "''$HOST")
      [[ -n "''$PORT" ]] && TSQL_CMD+=(-p "''$PORT")
      [[ -n "''$USER" ]] && TSQL_CMD+=(-U "''$USER")
      [[ -n "''$PASSWORD" ]] && TSQL_CMD+=(-P "''$PASSWORD")
      [[ -n "''$DATABASE" ]] && TSQL_CMD+=(-D "''$DATABASE")

      # Add any other arguments
      TSQL_CMD+=("''${OTHER_ARGS[@]}")

      # Execute tsql
      exec "''${TSQL_CMD[@]}"
    '';
    executable = true;
